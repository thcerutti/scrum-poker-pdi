# Preenchidas automaticamente pela integração Upstash Redis do Vercel Marketplace.
# Sem elas, o app usa um armazenamento em memória (serve só para desenvolvimento local).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa equivalente:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Chave do KLIPY (partner.klipy.com) para o GIF exibido ao revelar os votos.
# Vai para o bundle do navegador: os termos do KLIPY exigem a busca no cliente.
# Sem ela, o app funciona normalmente, só sem GIFs.
KLYPY_KEY=
